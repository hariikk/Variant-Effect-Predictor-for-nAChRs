{"geneId":"1146","symbol":"CHRNG","description":"cholinergic receptor nicotinic gamma subunit","taxId":"9606","taxname":"Homo sapiens","type":"PROTEIN_CODING","orientation":"plus","commonName":"human","chromosomes":["2"],"nomenclatureAuthority":{"authority":"HGNC","identifier":"HGNC:1967"},"swissProtAccessions":["P07510"],"ensemblGeneIds":["ENSG00000196811"],"omimIds":["100730"],"synonyms":["ACHRG"],"referenceStandards":[{"geneRange":{"accessionVersion":"NG_012954.2","range":[{"begin":"5001","end":"13424","orientation":"plus"}]},"type":"REFSEQ_GENE"}],"annotations":[{"assemblyAccession":"GCF_000001405.40","assemblyName":"GRCh38.p14","annotationName":"GCF_000001405.40-RS_2025_08","annotationReleaseDate":"2025-08-01","genomicLocations":[{"genomicAccessionVersion":"NC_000002.12","sequenceName":"2","genomicRange":{"begin":"232539692","end":"232548115","orientation":"plus"}}]},{"assemblyAccession":"GCF_009914755.1","assemblyName":"T2T-CHM13v2.0","annotationName":"GCF_009914755.1-RS_2025_08","annotationReleaseDate":"2025-08-01","genomicLocations":[{"genomicAccessionVersion":"NC_060926.1","sequenceName":"2","genomicRange":{"begin":"233026474","end":"233034899","orientation":"plus"}}]}],"transcriptCount":1,"proteinCount":1,"transcriptTypeCounts":[{"type":"PROTEIN_CODING","count":1}],"geneGroups":[{"id":"1146","method":"NCBI Ortholog"}],"summary":[{"description":"The mammalian muscle-type acetylcholine receptor is a transmembrane pentameric glycoprotein with two alpha subunits, one beta, one delta, and one epsilon (in adult skeletal muscle) or gamma (in fetal and denervated muscle) subunit. This gene, which encodes the gamma subunit, is expressed prior to the thirty-third week of gestation in humans. The gamma subunit of the acetylcholine receptor plays a role in neuromuscular organogenesis and ligand binding and disruption of gamma subunit expression prevents the correct localization of the receptor in cell membranes. Mutations in this gene cause Escobar syndrome and a lethal form of multiple pterygium syndrome. Muscle-type acetylcholine receptor is the major antigen in the autoimmune disease myasthenia gravis.[provided by RefSeq, Sep 2009]"}],"geneOntology":{"assignedBy":"GOA","molecularFunctions":[{"name":"acetylcholine receptor activity","goId":"GO:0015464","evidenceCode":"IBA","qualifier":"enables"},{"name":"acetylcholine receptor activity","goId":"GO:0015464","evidenceCode":"TAS","qualifier":"enables","reference":{"pmids":["3967651"]}},{"name":"acetylcholine-gated monoatomic cation-selective channel activity","goId":"GO:0022848","evidenceCode":"IBA","qualifier":"contributes_to"},{"name":"acetylcholine-gated monoatomic cation-selective channel activity","goId":"GO:0022848","evidenceCode":"IEA","qualifier":"enables"},{"name":"channel activity","goId":"GO:0015267","evidenceCode":"IEA","qualifier":"enables"},{"name":"channel activity","goId":"GO:0015267","evidenceCode":"TAS","qualifier":"enables","reference":{"pmids":["3967651"]}},{"name":"extracellular ligand-gated monoatomic ion channel activity","goId":"GO:0005230","evidenceCode":"IEA","qualifier":"enables"},{"name":"monoatomic ion channel activity","goId":"GO:0005216","evidenceCode":"IEA","qualifier":"enables"},{"name":"protein binding","goId":"GO:0005515","evidenceCode":"IPI","qualifier":"enables","reference":{"pmids":["25416956","25910212","29892012","31515488","32296183"]}},{"name":"transmembrane signaling receptor activity","goId":"GO:0004888","evidenceCode":"IEA","qualifier":"enables"},{"name":"transmitter-gated monoatomic ion channel activity involved in regulation of postsynaptic membrane potential","goId":"GO:1904315","evidenceCode":"ISS","qualifier":"enables"}],"biologicalProcesses":[{"name":"acetylcholine receptor signaling pathway","goId":"GO:0095500","evidenceCode":"IBA","qualifier":"involved_in"},{"name":"acetylcholine receptor signaling pathway","goId":"GO:0095500","evidenceCode":"NAS","qualifier":"involved_in","reference":{"pmids":["21480901"]}},{"name":"calcium io